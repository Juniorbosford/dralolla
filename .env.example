# Copie este arquivo para .env (uso local) ou cadastre as variáveis na aba Variables da Railway.

# Senha do painel /admin-leads.html (use algo longo e aleatório)
ADMIN_TOKEN=

# URL pública do site (opcional — na Railway é detectada sozinha pelo RAILWAY_PUBLIC_DOMAIN)
SITE_URL=

# Pasta onde os leads são salvos (opcional — na Railway use um Volume, que já preenche RAILWAY_VOLUME_MOUNT_PATH)
DATA_DIR=

# ---- WhatsApp Cloud API (só necessário se for usar o bot) ----
# Token de acesso permanente (System User) do app na Meta
TOKEN=
# ID do número de telefone (WhatsApp > API Setup)
PHONE_NUMBER_ID=
# Texto qualquer que você inventa e repete no painel da Meta ao configurar o webhook
VERIFY_TOKEN=
# App Secret (Configurações do app > Básico). Opcional, mas recomendado: valida que o webhook veio da Meta
APP_SECRET=
# Versão da Graph API (padrão: v26.0)
GRAPH_API_VERSION=
